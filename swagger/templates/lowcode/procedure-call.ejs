<%
const { utils, route, config, modelTypes } = it;
const { requestBodyInfo, responseBodyInfo, specificArgNameResolver } = route;
const { _, getInlineParseContent, getParseContent, parseSchema, getComponentByRef, require } = utils;
const { parameters, shortPath, method, payload, query, formData, security, requestParams } = route.request;
const { type, errorType, contentTypes } = route.response;
const { HTTP_CLIENT, RESERVED_REQ_PARAMS_ARG_NAMES } = config.constants;
const routeDocs = includeFile("./route-docs", { config, route, utils });
const queryName = (query && query.name) || "query";
const pathParams = _.values(parameters);
const pathParamsNames = _.map(pathParams, "name");

const isFetchTemplate = config.httpClientType === HTTP_CLIENT.FETCH;

const requestConfigParam = {
    name: specificArgNameResolver.resolve(RESERVED_REQ_PARAMS_ARG_NAMES),
    optional: true,
    type: "RequestParams",
    defaultValue: "{}",
}

const argToTmpl = ({ name, optional, type, defaultValue }) => `${name}${!defaultValue && optional ? '?' : ''}: ${type}${defaultValue ? ` = ${defaultValue}` : ''}`;

const originalRouteName = _.replace(route.raw.operationId, /_\d+$/, '')
// ApiResource already owns HTTP verb methods. Avoid generating an endpoint
// method that shadows this.delete()/this.get()/etc. and recursively calls itself.
const routeName = ['get', 'post', 'put', 'patch', 'delete'].includes(originalRouteName)
  ? `${originalRouteName}Endpoint`
  : originalRouteName
if (payload) {
  const model = modelTypes.find(item => item.name === payload.type)
  if (model && (model.allFieldsAreOptional || payload.optional)) {
    payload.defaultValue = "{}"
  }
}

const rawWrapperArgs = config.extractRequestParams ?
    _.compact([
        requestParams && {
          name: pathParams.length ? `{ ${_.join(pathParamsNames, ", ")}, ...${queryName} }` : queryName,
          optional: false,
          type: getInlineParseContent(requestParams),
        },
        ...(!requestParams ? pathParams : []),
        payload,
    ]) :
    _.compact([
        ...pathParams,
        query,
        payload,
    ])

const wrapperArgs = _
    // Sort by optionality
    .sortBy(rawWrapperArgs, [o => o.optional])
    .map(argToTmpl)
    .join(', ')

// RequestParams["type"]
const requestContentKind = {
    "JSON": "ContentType.Json",
    "URL_ENCODED": "ContentType.UrlEncoded",
    "FORM_DATA": "ContentType.FormData",
    "TEXT": "ContentType.Text",
}
// RequestParams["format"]
const responseContentKind = {
    "JSON": '"json"',
    "IMAGE": '"blob"',
    "FORM_DATA": isFetchTemplate ? '"formData"' : '"document"'
}

const bodyTmpl = _.get(payload, "name") || undefined;
const queryTmpl = (query != null && queryName) || undefined;
const bodyContentKindTmpl = requestContentKind[requestBodyInfo.contentKind] || null;
const responseFormatTmpl = responseContentKind[responseBodyInfo.success && responseBodyInfo.success.schema && responseBodyInfo.success.schema.contentKind] || null;
const securityTmpl = security ? 'true' : null;


let configStr = '';
[
  ['method', `'${_.upperCase(method)}'`],
  ['data', bodyTmpl],
  ['params', queryTmpl]
].forEach(([k, v]) => v && (configStr += `${k}: ${v},`));
%>
/**
<%~ routeDocs.lines %>

 */
<%~ routeName %>(<%~ wrapperArgs %><%~ wrapperArgs ? ',' : ''%> config?: RequestConfig) {
    <%
    let output = ''
    if (type == 'void') {
      output =`return this.downloadFile(\`${shortPath}\`, { ${configStr} ...config})`
    } else {
      let _type = type === 'AjaxResult' ? '' : type
      const model = _type.startsWith('AjaxResult') && modelTypes.find(item => item.name === type)
      if (model) {
        _type =  model.properties.data.$parsed.content
        if (!model.properties.data.type) {
          _type = `Required<${_type}>`
        }
      }
      output = `return this.${_.lowerCase(method)}${_type && `<${_type}>`}(\`${shortPath}\`, ${queryTmpl || bodyTmpl}, config)`
    }
    %>
    <%~ output %>
},
