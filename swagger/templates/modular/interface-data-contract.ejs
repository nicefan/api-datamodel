<%
const { contract, utils } = it;
const { formatDescription, require, _ } = utils;

const getRequired = () => ['OutBO', 'OutVO', 'PageVO'].some(str => contract.name.endsWith(str))
%>
<% if (!contract.name.startsWith('AjaxResult')){ %>
export interface <%~ contract.name %> {
  <% _.forEach(contract.$content, (field) => { %>
    <%~ includeFile('@base/object-field-jsdoc.ejs', { ...it, field }) %>
    <%~ field.name %><%~ field.isRequired || getRequired() ? '' : '?' %>: <%~ field.value %><%~ field.isNullable ? ' | null' : ''%>;
  <% }) %>
}
<%}%>
