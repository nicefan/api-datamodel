<%
const { utils, config, route, modelTypes } = it;
const { _, pascalCase } = utils;
const { routes, moduleName } = route;
const responseSchemaPrefix = config.responseSchema.namePrefix;
const dataContracts = config.modular
  ? _.map(modelTypes, "name").filter(name => !responseSchemaPrefix || !name.startsWith(responseSchemaPrefix))
  : [];

%>
<% if (dataContracts.length) { %>
import { <%~ dataContracts.join(", ") %> } from "./<%~ config.fileNames.dataContracts %>"
<% } %>

export namespace <%~ pascalCase(moduleName) %> {
    <% _.forEach(routes, (route) => { %>

        <%~ includeFile('@base/route-type.ejs', { ...it, route }) %>

    <% }) %>
}
