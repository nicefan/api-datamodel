{
  "name": "api-datamodel",
  "version": "1.1.0",
  "description": "TypeScript business API modeling and OpenAPI code generation for Axios, Fetch, UniApp, and Taro.",
  "keywords": [
    "typescript",
    "api",
    "api-client",
    "api-modeling",
    "openapi",
    "swagger",
    "codegen",
    "http-client",
    "axios",
    "fetch",
    "uniapp",
    "taro"
  ],
  "author": {
    "name": "nicefan",
    "email": "covien@msn.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicefan/api-datamodel.git"
  },
  "homepage": "https://nicefan.github.io/api-datamodel/",
  "bugs": {
    "url": "https://github.com/nicefan/api-datamodel/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "types",
    "codegen"
  ],
  "bin": {
    "api-datamodel-codegen": "./codegen/main.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint . --fix --ignore-path .gitignore",
    "codegen": "node ./codegen/main.js",
    "test": "pnpm run build && node --test test/regressions.test.js test/swagger-config.test.js"
  },
  "dependencies": {
    "inquirer": "^9.1.3",
    "jiti": "^2.7.0",
    "swagger-typescript-api": "12.0.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-eslint": "^9.0.4",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.1",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.3.2",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "lodash": "^4.17.21",
    "prettier": "2.8.8",
    "rollup": "^3.25.3",
    "rollup-plugin-dts": "^5.3.0",
    "tsc": "^2.0.4",
    "tslib": "^2.6.0",
    "typescript": "^5.1.3"
  }
}
